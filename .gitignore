# ==========================================================
#  リポジトリ直下に誤って作られた空の Unity プロジェクトの残骸
#  （Unity Hub で BackroomsRT ではなく backroom2 を開くとこうなる）
# ==========================================================
/Assets/
/Library/
/Logs/
/Packages/
/ProjectSettings/
/Temp/
/UserSettings/

# ==========================================================
#  作業成果物
#  shots/ と *_report.txt は履歴に残す。
#  ログ・API レスポンス・素材の元 zip は再取得できるので残さない。
# ==========================================================
artifacts/dl/
artifacts/previews/
artifacts/*.log
artifacts/*.json
artifacts/sheet_*.png
artifacts/hdrp_asset_properties.txt
